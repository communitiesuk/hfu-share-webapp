{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
        "release-type": "python",
        "include-v-in-tag": false,
        "draft": false,
        "pull-request-header": ":robot: Next release",
        "pull-request-footer": " ",
        "extra-files": [
          {
            "type": "toml",
            "path": "uv.lock",
            "jsonpath": "$.package[?(@.name.value=='hfu-case-management-webapp')].version"
          }
        ]
    }
  }
}
